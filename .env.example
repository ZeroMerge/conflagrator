# Copy this file to .env and fill in the secret values before deploying.
# Do NOT commit actual secret values to the repo.

# Cloudinary (server)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=OREOLUWA PERSONAL

# Cloudinary (client)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_FOLDER=OREOLUWA PERSONAL

# Admin auth
ADMIN_PASSWORD=
SESSION_SECRET=

# Optional
PORT=3000
