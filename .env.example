# Neon Postgres Database (required)
# Get from https://console.neon.tech - copy the PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/dbname

# Cloudinary (required for image uploads)
# Get from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
CLOUDINARY_FOLDER=OREOLUWA PERSONAL
# These are server-only (don't expose to browser):
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Admin Authentication
# Create a strong password for admin login
ADMIN_PASSWORD=Oreoluwa_Admin_2026!SecureKey

# Session Security
# Generate with: openssl rand -hex 32
SESSION_SECRET=your_random_session_secret_here
SESSION_COOKIE=oreoluwa_session_cookie_v1
